{
  "name": "ghub",
  "version": "1.5.1",
  "description": "Multi-inbox Gmail, Drive, Sheets, Docs, and Calendar MCP server with built-in OAuth onboarding",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ghub": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "postinstall": "bash scripts/build-ocr.sh"
  },
  "keywords": [
    "mcp",
    "gmail",
    "multi-inbox",
    "oauth",
    "model-context-protocol"
  ],
  "author": "Tyler Szakacs",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/express": "^5.0.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^10.9.0",
    "googleapis": "^171.4.0",
    "mammoth": "^1.13.0",
    "officeparser": "6.0.7",
    "pdf-parse": "^1.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "officeparser": {
      "pdfjs-dist": "5.5.207"
    },
    "google-auth-library": "$google-auth-library"
  }
}
