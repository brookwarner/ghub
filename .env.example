# Optional: override the default config directory (~/.gmail-multi-mcp)
GMAILMCPCONFIG_DIR=/Users/tyler/.gmail-multi-mcp

# Optional: force the HTTP/SSE transport instead of stdio
MCP_TRANSPORT=sse

# Required when SSE transport is exposed: bearer token for all API/MCP calls.
# Send via "Authorization: Bearer <token>" header. Query-string token only
# accepted on GET / (dashboard bootstrap), then stripped from the URL.
SECRET_TOKEN=

# Comma-separated list of origins allowed for CORS (e.g. https://app.example.com).
# Empty/unset = no cross-origin browser access (recommended).
ALLOWED_ORIGINS=

# Absolute directory that send_email/create_draft attachment paths must live
# inside. Unset = file attachments are rejected.
ATTACHMENT_DIR=
